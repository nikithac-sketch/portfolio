# ==========================================
# OpenAI & GPT-6 Astra Configuration
# ==========================================

# Your OpenAI API Key (Required)
OPENAI_API_KEY=your-openai-api-key-here

# Model Identifier (Optional, defaults to gpt-6-astra)
OPENAI_MODEL=gpt-6-astra

# Custom Base URL (Optional, defaults to https://api.openai.com/v1)
# Use this if using an Azure endpoint, Bedrock proxy, or local gateway
OPENAI_BASE_URL=https://api.openai.com/v1

# Local Backend API Server Config (Optional)
API_HOST=127.0.0.1
API_PORT=5050
